{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignalExplanation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "explanation",
    "confidence",
    "key_drivers",
    "risk_callouts",
    "timeframe_alignment",
    "recommended_action",
    "short_summary"
  ],
  "properties": {
    "explanation": {
      "type": "string",
      "maxLength": 800
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "key_drivers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "maxLength": 160
      }
    },
    "risk_callouts": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "maxLength": 160
      }
    },
    "timeframe_alignment": {
      "type": "string",
      "enum": ["scalp", "intra", "swing", "position"]
    },
    "recommended_action": {
      "type": "string",
      "enum": ["publish", "defer", "drop"]
    },
    "short_summary": {
      "type": "string",
      "maxLength": 240
    }
  }
}
