# Redis connection used for distributed fingerprint locks
REDIS_URL=redis://localhost:6379/0

# API tokens for HTTP authentication (comma separated)
CODEX_API_TOKENS=changeme-token-1,changeme-token-2

# News provider credentials (leave blank for mock providers)
PROVIDER_TWITTER_BEARER=
PROVIDER_REDDIT_CLIENT_ID=
PROVIDER_REDDIT_CLIENT_SECRET=
PROVIDER_REDDIT_USER_AGENT=codex-dev/0.1
NEWS_RSS_URLS=https://example.com/feed.rss

# Qwen / DashScope (OpenAI-compatible)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_VERSION=2023-06-01

# Shared LLM call limits
LLM_TIMEOUT_MS=2500
LLM_RETRY_MAX=1
LLM_RETRY_BACKOFF_MS=250
