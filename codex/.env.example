# Redis connection used for distributed fingerprint locks
REDIS_URL=redis://localhost:6379/0

# API tokens for HTTP authentication (comma separated)
CODEX_API_TOKENS=changeme-token-1,changeme-token-2

# News provider credentials (leave blank for mock providers)
PROVIDER_TWITTER_BEARER=
PROVIDER_REDDIT_CLIENT_ID=
PROVIDER_REDDIT_CLIENT_SECRET=
PROVIDER_REDDIT_USER_AGENT=codex-dev/0.1
NEWS_RSS_URLS=https://example.com/feed.rss
